---
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---

<Layout
  title={frontmatter.title ?? "wdoc blog"}
  description={frontmatter.description}
  image={frontmatter.image}
>
  <article class="w-full max-w-3xl px-4 sm:px-6 lg:px-8 py-16 sm:py-24">

    {frontmatter.image && (
      <img
        src={frontmatter.image}
        alt={frontmatter.title}
        class="w-full rounded-xl mb-8 shadow-sm object-cover"
      />
    )}

    <header class="mb-8">
      {frontmatter.date && (
        <p class="text-sm text-gray-500">{frontmatter.date}</p>
      )}

      <h1 class="mt-2 text-3xl sm:text-4xl font-bold text-gray-900">
        {frontmatter.title}
      </h1>

      {frontmatter.description && (
        <p class="mt-3 text-gray-600">
          {frontmatter.description}
        </p>
      )}
    </header>

    <div class="prose prose-gray max-w-none">
      <slot />
    </div>
  </article>
</Layout>