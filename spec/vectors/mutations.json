{
  "cases": [
    {
      "id": "modified-original",
      "description": "Original bytes invalidate their signature and dependent trusted original bindings.",
      "base": "sealed",
      "operations": [
        {
          "op": "file-set",
          "path": "index.html",
          "text": "<p>Changed original</p>"
        }
      ],
      "expected": {
        "content": "file-modified",
        "document": [
          "file-modified"
        ],
        "forms": [
          "wrong-revision"
        ],
        "seals": [
          "wrong-revision"
        ]
      }
    },
    {
      "id": "modified-answer",
      "description": "Answer bytes are protected independently of the original.",
      "base": "sealed",
      "operations": [
        {
          "op": "file-set",
          "path": "submissions/22222222-2222-4222-8222-222222222222/answers.json",
          "text": "{}"
        }
      ],
      "expected": {
        "document": [
          "valid-trusted"
        ],
        "forms": [
          "file-modified"
        ],
        "seals": [
          "archive-changed"
        ]
      }
    },
    {
      "id": "missing-attachment",
      "description": "Every enumerated snapshot attachment is required.",
      "base": "sealed",
      "operations": [
        {
          "op": "file-delete",
          "path": "submissions/22222222-2222-4222-8222-222222222222/attachments/1-proof.txt"
        }
      ],
      "expected": {
        "forms": [
          "file-modified"
        ],
        "seals": [
          "archive-changed"
        ]
      }
    },
    {
      "id": "wrong-original-nonce",
      "description": "A wrapper nonce must open the signed original commitment.",
      "base": "sealed",
      "operations": [
        {
          "op": "manifest-set",
          "pointer": "/signatures/document/0/nonce",
          "value": "4OHi4-Tl5ufo6err7O3u7_Dx8vP09fb3-Pn6-_z9_v8"
        }
      ],
      "expected": {
        "document": [
          "wrong-revision"
        ],
        "forms": [
          "wrong-revision"
        ],
        "seals": [
          "wrong-revision"
        ]
      }
    },
    {
      "id": "missing-form-nonce",
      "description": "A commitment-mode form requires its local nonce.",
      "base": "sealed",
      "operations": [
        {
          "op": "manifest-delete",
          "pointer": "/signatures/forms/0/nonce"
        }
      ],
      "expected": {
        "error": true
      }
    },
    {
      "id": "wrong-form-reference",
      "description": "An unrelated wrapper form ID does not resolve this snapshot.",
      "base": "sealed",
      "operations": [
        {
          "op": "manifest-set",
          "pointer": "/signatures/forms/0/formId",
          "value": "other"
        }
      ],
      "expected": {
        "forms": [
          "wrong-revision",
          "unsigned"
        ],
        "seals": [
          "archive-changed"
        ]
      }
    },
    {
      "id": "missing-seal-nonce",
