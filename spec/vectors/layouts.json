{
  "description": "Exact ZIP entry names and UTF-8 text. Directory names end in a slash. All cases are tested as STORED and DEFLATE ZIPs; no files are implicitly generated. Without a manifest, a valid layout is unsigned.",
  "cases": [
    {
      "id": "index-only",
      "entries": {
        "index.html": "<p>Unsigned document</p>"
      },
      "valid": true,
      "rootPrefix": "",
      "logicalFiles": [
        "index.html"
      ]
    },
    {
      "id": "index-with-resource-folders",
      "entries": {
        "index.html": "<p>Unsigned document</p>",
        "images/logo.png": "resource",
        "styles/main.css": "resource"
      },
      "valid": true,
      "rootPrefix": "",
      "logicalFiles": [
        "images/logo.png",
        "index.html",
        "styles/main.css"
      ]
    },
    {
