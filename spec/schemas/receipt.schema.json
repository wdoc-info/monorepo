{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.wdoc.info/schemas/receipt.schema.json",
  "type": "object",
  "properties": {
    "signatureId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$(?![\\s\\S])"
    },
    "jws": {
      "$ref": "https://www.wdoc.info/schemas/common.schema.json#/definitions/compactJws"
    }
  },
  "required": [
    "signatureId",
    "jws"
  ],
  "additionalProperties": false
}
