{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.wdoc.info/schemas/document-jws.schema.json",
  "description": "Decoded commitment-only JWS payload. Key authority and semantic bindings are defined in WDOC-FORMAT.",
  "type": "object",
  "properties": {
    "type": {
      "const": "wdoc-document-signature"
    },
    "proofMode": {
      "const": "digest-only"
    },
    "documentCommitment": {
      "$ref": "https://www.wdoc.info/schemas/common.schema.json#/definitions/digest"
    },
    "signer": {
      "$ref": "https://www.wdoc.info/schemas/common.schema.json#/definitions/signer"
    },
    "signedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$(?![\\s\\S])"
    },
    "evidence": {
      "$ref": "https://www.wdoc.info/schemas/common.schema.json#/definitions/platformEvidence"
    }
  },
  "required": [
    "type",
    "proofMode",
    "documentCommitment",
    "signer",
    "signedAt",
    "evidence"
  ],
  "additionalProperties": false
}
