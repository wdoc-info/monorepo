{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.wdoc.info/schemas/answers-html.schema.json",
  "description": "HTML collection profile only. The lower-level signing interface also accepts other JSON answers; snapshot verification authenticates file bytes rather than enforcing this application schema.",
  "type": "object",
  "additionalProperties": {
    "type": "array",
    "items": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "attachment": {
              "allOf": [
                {
                  "$ref": "https://www.wdoc.info/schemas/common.schema.json#/definitions/safePath"
                },
                {
                  "pattern": "^[^/]+$(?![\\s\\S])"
                }
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "attachment"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
