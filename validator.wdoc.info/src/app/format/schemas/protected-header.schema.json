{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.wdoc.info/schemas/protected-header.schema.json",
  "type": "object",
  "properties": {
    "alg": {
      "const": "ES256"
    },
    "typ": {
      "enum": [
        "wdoc-document+jws",
        "wdoc-form+jws",
        "wdoc-seal+jws"
      ]
    },
    "kid": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@]+/info/[A-Za-z0-9_-]+$(?![\\s\\S])"
    }
  },
  "required": [
    "alg",
    "typ",
    "kid"
  ],
  "additionalProperties": false,
  "description": "Closed producer header. Registry authorization additionally requires exact HTTPS origin allow-list membership and exact registered KID equality."
}
