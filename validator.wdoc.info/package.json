{
  "name": "wdoc-validator",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "ng serve --port 4300",
    "build": "ng build --configuration production",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node scripts/sync-format.mjs --check && bun test tests --coverage",
    "e2e": "playwright test",
    "format:sync": "node scripts/sync-format.mjs"
  },
  "dependencies": {
    "@angular/common": "20.3.14",
    "@angular/compiler": "20.3.14",
    "@angular/core": "20.3.14",
    "@angular/platform-browser": "20.3.14",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0",
    "jose": "5.10.0",
    "jszip": "3.10.1",
    "parse5": "7.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.12",
    "@angular/cli": "20.3.12",
    "@angular/compiler-cli": "20.3.14",
    "@playwright/test": "1.57.0",
    "@types/bun": "1.3.8",
    "typescript": "5.8.3"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
